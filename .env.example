# --- LLM provider: hosted (default, fast) or local Ollama ---
# Default is the hosted Groq path: ~2-3s/call on openai/gpt-oss-120b, measurably more capable
# extraction than CPU-only phi3:mini (30-90s+/call). Just set OPENAI_COMPATIBLE_API_KEY below.
# For fully local/offline/private inference instead (the original DoD's local-Phi-3-mini path),
# set LLM_PROVIDER=ollama, pull the model (`ollama pull phi3:mini`), and run `ollama serve`.
LLM_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=openai/gpt-oss-120b
# Separate model for the text ReAct agent loop: gpt-oss-120b (a "reasoning" model) gets stuck
# re-doing step 1 forever instead of reading its own Observations; qwen3.8-27b does not.
OPENAI_COMPATIBLE_AGENT_MODEL=qwen/qwen3.8-27b
OPENAI_COMPATIBLE_API_KEY=

LLM_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
NUM_CTX=4096
LLM_TIMEOUT_S=120
OFFLINE_MODE=false          # true = no LLM: keyword extraction + template bullets (CI, emergencies)
USE_AGENT=true              # false = deterministic orchestrator only
USE_EMBEDDINGS=true         # needs requirements-ml.txt
USE_SKILLNER=false
EMBED_MODEL=BAAI/bge-small-en-v1.5
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data
DB_PATH=data/results.db
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Knowledge graph live trace (new) ---
KG_TRACE_ENABLED=true
