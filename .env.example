LLM_PROVIDER=ollama
LLM_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
NUM_CTX=4096
LLM_TIMEOUT_S=120
OFFLINE_MODE=false          # true = no LLM: keyword extraction + template bullets (CI, emergencies)
USE_AGENT=true              # false = deterministic orchestrator only
USE_EMBEDDINGS=true         # needs requirements-ml.txt
USE_SKILLNER=false
EMBED_MODEL=BAAI/bge-small-en-v1.5
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data
DB_PATH=data/results.db
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Cloud/hosted inference fallback (used when LLM_PROVIDER=openai_compatible) ---
# Lets you deploy to Render without self-hosting Ollama. Point this at any
# OpenAI-compatible chat-completions endpoint that serves a small, fast model
# (Groq, Together, Fireworks, OpenRouter, etc.). Never commit real keys.
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=llama-3.1-8b-instant
OPENAI_COMPATIBLE_API_KEY=

# --- Knowledge graph live trace (new) ---
KG_TRACE_ENABLED=true
